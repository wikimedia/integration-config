#!/bin/bash

set -eux -o pipefail

git clone https://github.com/nikic/php-ast

pushd php-ast
# ast v1.1.4. We use sha1 for immutability
git checkout --quiet 6ed5b216103171cb5fdea41d1b08f72b7b3de87b
git describe --tags
phpize
./configure
make
popd

mkdir -p artifacts
mv php-ast/modules/ast.so artifacts/ast.so
echo 'extension=ast.so' > artifacts/ast.ini
